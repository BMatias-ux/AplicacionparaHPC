# Copiar como .env.local para desarrollo. .env.local NO se sube a GitHub.
# En producción, las mismas variables van en Vercel → app-hpc → Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La "anon public" key. Es pública por diseño: lo que protege los datos son las políticas RLS.
# NUNCA poner acá la service_role key.
VITE_SUPABASE_ANON_KEY=

# "Continuar con Google" en Mi espacio. Poner true SÓLO después de activar el proveedor Google en Supabase
# (ver docs/09-cuentas-pacientes.md, paso 6). Si falta o es otro valor, el botón no aparece.
VITE_GOOGLE_ACTIVO=false
